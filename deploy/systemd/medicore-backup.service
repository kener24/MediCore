[Unit]
Description=MediCore encrypted database and media backup
After=mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/medicore
Environment=MEDICORE_APP_DIR=/var/www/medicore
ExecStart=/var/www/medicore/deploy/scripts/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
