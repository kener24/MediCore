[Unit]
Description=MediCore operational health verification
After=network-online.target medicore.service nginx.service mysql.service
OnFailure=medicore-monitor-alert.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/medicore
ExecStart=/var/www/medicore/deploy/scripts/operational-check.sh
PrivateTmp=true
